@startuml Activite_Traitement_Attaque
!theme plain
title Diagramme d'activité - Cycle de vie d'une attaque

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFF5B3
  BorderColor black
  DiamondBackgroundColor #FFD9B3
  DiamondBorderColor black
}

|Attaquant|
start
:Tentative de connexion\nsur un service exposé;

|Agent Honeypot|
:Accepte la connexion\n(service simulé);
:Capture les données\nde l'attaque;
:Envoie le rapport\nau serveur;

|Serveur d'application|
if (Agent authentifié ?) then (non)
  :Rejette la demande;
  stop
else (oui)
endif

:Uniformise les données;
:Enregistre l'attaque\nen base de données;
:Met à jour les statistiques\n(IP, service, identifiants);

if (Export automatique\nactivé ?) then (oui)
  :Envoie les indicateurs\nvers SIEM et CTI;
else (non)
endif

|Analyste SOC|
:Consulte le tableau de bord;

if (Menace critique ?) then (oui)
  :Analyse l'attaque\nen détail;
  :Exporte manuellement\nles indicateurs;
  :Met à jour les règles\nde détection;
else (non)
  :Laisse l'agent\ncontinuer à collecter;
endif
stop

@enduml
