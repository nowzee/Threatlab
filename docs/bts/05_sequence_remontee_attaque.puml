@startuml Sequence_Remontee_Attaque
!theme plain
title Diagramme de séquence - Remontée et traitement d'une attaque

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #333
  LifeLineBorderColor #333
  ParticipantBorderColor black
  ParticipantBackgroundColor #FFD9B3
  ActorBackgroundColor #FFB3B3
}

actor "Attaquant" as atk
participant "Agent\nHoneypot" as agent
participant "Serveur\nd'application" as back
database "Base de\ndonnées" as db
participant "Tableau\nde bord" as dash
actor "Analyste" as sec

autonumber

atk -> agent : Tentative de connexion
activate agent
agent -> agent : Capture les informations\n(IP, identifiants, commandes)
agent -> back : Envoi du rapport d'attaque\n(authentifié)
deactivate agent
activate back

back -> back : Vérifie l'authenticité\nde l'agent
back -> back : Normalise les données\nreçues

back -> db : Enregistre l'attaque
back -> db : Met à jour l'IP malveillante\n(score, dernière vue)
back -> db : Met à jour les statistiques\npar service
back -> db : Enregistre les identifiants\ncompromis

back --> agent : Rapport reçu
deactivate back

... Quelques instants plus tard ...

sec -> dash : Ouvre le tableau de bord
activate dash
dash -> back : Demande les données\nd'attaques récentes
activate back
back -> db : Récupère les statistiques
db --> back : Données agrégées
back --> dash : Données d'affichage
deactivate back
dash -> sec : Affiche le graphique\net les nouvelles alertes
deactivate dash

@enduml
