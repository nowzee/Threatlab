@startuml Sequence_Export_CTI
!theme plain
title Diagramme de séquence - Export CTI vers ELK et OpenCTI

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #333
  LifeLineBorderColor #333
  ParticipantBorderColor black
  ParticipantBackgroundColor #FFD9B3
  ActorBackgroundColor #B3D9FF
}

actor "Analyste" as sec
participant "Interface\nThreat Intel" as front
participant "Serveur\nd'application" as back
database "Base de\ndonnées" as db
cloud "Elasticsearch\n(SIEM)" as elk
cloud "OpenCTI\n(plateforme CTI)" as octi

autonumber

sec -> front : Clique sur "Exporter les IOC"
front -> back : Demande d'export
activate back

back -> back : Vérifie l'authentification
back -> db : Récupère les IP malveillantes
db --> back : Liste des IP
back -> db : Récupère les identifiants compromis
db --> back : Liste des credentials
back -> db : Récupère les empreintes\nde malwares
db --> back : Liste des hashs

back -> db : Récupère les clés des\nintégrations configurées
db --> back : Clés API

par Envoi vers Elasticsearch
  back -> back : Prépare les données\nau format SIEM
  back -> elk : Envoi des indicateurs
  elk --> back : Indexation confirmée
and Envoi vers OpenCTI
  back -> back : Prépare les données\nau format CTI standard
  back -> octi : Envoi des indicateurs
  octi --> back : Indicateurs créés
end

back --> front : Rapport d'export\n(nombre d'IOC envoyés)
deactivate back

front -> sec : Affiche le résumé\nde l'export

@enduml
