@startuml Architecture_Globale_ThreatLab
!theme plain
title Architecture globale de ThreatLab

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor<<frontend>> #B3D9FF
  BackgroundColor<<backend>> #FFD9B3
  BackgroundColor<<db>> #D9FFB3
  BackgroundColor<<ext>> #FFB3D9
  BorderColor black
}

actor "Administrateur\nSOC" as admin
actor "Agent\nHoneypot" as agent
actor "Attaquant" as attacker

package "Serveur ThreatLab (Docker)" {
  component "Frontend Vue 3\n(SPA + Vite)" <<frontend>> as front
  component "Backend Flask\n(API REST)" <<backend>> as back
  database "MySQL\n(12 tables)" <<db>> as db

  package "Modules Backend" {
    component "Auth\n(Session + A2F)" <<backend>> as auth
    component "Agents\n(JWT)" <<backend>> as agm
    component "Log Analyse" <<backend>> as loga
    component "CTI / Threat Intel" <<backend>> as cti
    component "Intégrations\n(ELK / OpenCTI)" <<backend>> as integ
  }
}

cloud "Elasticsearch / Kibana" <<ext>> as elk
cloud "OpenCTI" <<ext>> as opencti

admin --> front : HTTPS
front --> back : Requêtes API\n(JSON)
back --> auth
back --> agm
back --> loga
back --> cti
back --> integ
auth --> db
agm --> db
loga --> db
cti --> db
integ --> elk : Indexation des logs
integ --> opencti : Export des IOC

attacker ..> agent : Attaques\n(SSH, FTP, HTTP...)
agent --> agm : POST /api/agent/report\n(JWT)

@enduml
