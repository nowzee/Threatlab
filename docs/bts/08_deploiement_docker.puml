@startuml Deploiement_Docker
!theme plain
title Diagramme de déploiement - Conteneurisation Docker

skinparam backgroundColor #FFFFFF
skinparam node {
  BackgroundColor #D9E8FF
  BorderColor black
}
skinparam component {
  BackgroundColor #FFF5B3
  BorderColor black
}
skinparam database {
  BackgroundColor #D9FFB3
  BorderColor black
}

node "Serveur hôte (Linux)" as host {

  node "Docker Engine" as docker {

    node "Conteneur: frontend" as c_front {
      component "Nginx\n(port 80/443)" as nginx
      component "Build Vue 3\n(dist/)" as vuebuild
      nginx --> vuebuild
    }

    node "Conteneur: backend" as c_back {
      component "Flask + Gunicorn\n(port 5000)" as flask
      component "Modules Python\n(auth, agents, CTI)" as modules
      flask --> modules
    }

    node "Conteneur: database" as c_db {
      database "MySQL 8\n(port 3306)" as mysql
      folder "Volume persistant\n/var/lib/mysql" as vol
      mysql --> vol
    }

    cloud "Réseau Docker\n(bridge: threatlab_net)" as net

    nginx ..> net
    flask ..> net
    mysql ..> net
  }

  folder "Fichiers hôte" as files {
    artifact ".env\n(secrets, DB creds)" as env
    artifact "docker-compose.yml" as compose
  }

  compose ..> docker : orchestre
  env ..> c_back : variables d'env
  env ..> c_db : variables d'env
}

actor "Utilisateur\n(navigateur)" as user
node "Agents Honeypot\n(hôtes distants)" as remote_agents

user --> nginx : HTTPS\n(port 443)
nginx --> flask : Reverse proxy\n/api/*
flask --> mysql : SQL (port 3306,\nréseau Docker)

remote_agents --> flask : HTTPS /api/agent/report\n(JWT)

note right of c_back
  Image: python:3.11-slim
  Entrypoint: app.py
  Expose: 5000
end note

note right of c_db
  Image: mysql:8.0
  Init: schemas.sql
  Volume: mysql_data
end note

note right of c_front
  Build multi-stage :
  node:20 -> nginx:alpine
end note

@enduml
