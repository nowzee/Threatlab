{
  "metadata": {
    "name": "ssh-basique",
    "description": "SSH faible interactivité: capture des credentials."
  },
  "spec": {
    "services": [
      {
        "type": "ssh",
        "listen": { "host": "0.0.0.0", "port": 22 },
        "banner": "OpenSSH_7.4p1 Debian-10+deb9u7",
        "Simulation": false,
        "limits": {
          "egress": false,
          "max_connections": 3
        }
      }
    ],
    "agent": {
      "telemetry": { "interval_sec": 30, "batch_max": 100 },
      "updates": "auto"
    }
  }
}