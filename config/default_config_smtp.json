{
  "metadata": {
    "name": "smtp-trap",
    "description": "SMTP spam/phishing: capture entêtes, corps, expéditeur, destinataire et pièces jointes."
  },
  "spec": {
    "services": [
      {
        "type": "smtp",
        "listen": { "host": "0.0.0.0", "port": 25 },
        "tls": { "enabled": false, "starttls": false },
        "accept_relay": false,
        "max_message_size_mb": 25,
        "attachments": { "store": true, "max_per_message": 5 },
        "logging": {
          "level": "info",
          "headers": true,
          "body": true,
          "attachments_meta": true
        },
        "limits": {
          "egress": false,
          "max_connections": 50
        }
      }
    ],
    "agent": {
      "telemetry": { "interval_sec": 30, "batch_max": 200 },
      "updates": "auto"
    }
  }
}